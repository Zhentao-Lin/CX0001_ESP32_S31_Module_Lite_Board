menu "Example Configuration"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    config BLINK_GPIO
        int "Blink GPIO number"
        range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
        default 38
        help
            GPIO number (e.g. GPIO_NUM_38) to which the LED is connected.

            Default is 38, the on-board LED of the CX-ESP32-S31 board.
            Change it via 'idf.py menuconfig' if the LED is wired elsewhere.

    config BLINK_DELAY_MS
        int "Blink interval (ms)"
        range 1 10000
        default 300
        help
            Time in milliseconds the LED stays ON, and also stays OFF,
            before toggling again.

            Default is 300 ms, i.e. the LED blinks every 0.3 s.

endmenu
